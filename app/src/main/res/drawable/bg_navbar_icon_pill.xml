<?xml version="1.0" encoding="utf-8"?>
<!-- v2.9.14: only the selected tab gets a soft green pill; taps show a ripple (foreground of the tab) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="#1A00FF66"/><corners android:radius="16dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#00000000"/><corners android:radius="16dp"/></shape>
    </item>
</selector>
