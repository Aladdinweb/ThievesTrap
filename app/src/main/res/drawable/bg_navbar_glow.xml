<?xml version="1.0" encoding="utf-8"?>
<!-- Stepped warm-orange halo drawn behind the pill, works on every API level -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08FF9800"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <item android:top="1.5dp" android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#10FF9800"/>
            <corners android:radius="26.5dp"/>
        </shape>
    </item>
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#1AFF9800"/>
            <corners android:radius="25dp"/>
        </shape>
    </item>
</layer-list>
