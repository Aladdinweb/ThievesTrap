<?xml version="1.0" encoding="utf-8"?>
<!-- v2.9.14: tap ripple, no glow. Mask keeps the ripple inside the rounded shape. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF"/><corners android:radius="14dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#1B8A3A"/><corners android:radius="14dp"/></shape>
    </item>
</ripple>
