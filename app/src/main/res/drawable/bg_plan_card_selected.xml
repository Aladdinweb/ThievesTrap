<?xml version="1.0" encoding="utf-8"?>
<!-- Selected pricing card: gold glowing border, slightly lifted fill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#30FFD700"/>
            <corners android:radius="19dp"/>
        </shape>
    </item>
    <item android:top="2dp" android:bottom="2dp" android:start="2dp" android:end="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1C1808"/>
            <stroke android:width="1.5dp" android:color="#FFD700"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
