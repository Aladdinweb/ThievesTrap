<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#050508">

    <!-- Header: title, info icon, back -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#0D0D10" android:padding="16dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:text="@string/fn_title"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:id="@+id/btn_family_info"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:text="&#8505;&#65039;"
                    android:textSize="22sp" android:gravity="center"
                    android:layout_marginStart="8dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/fn_info_desc"/>
            </LinearLayout>
            <TextView android:text="@string/fn_subtitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#666666"/>
        </LinearLayout>

        <Button android:id="@+id/btn_back_family" android:layout_width="wrap_content"
            android:layout_height="36dp" android:text="@string/back_arrow" android:textSize="12sp"
            android:backgroundTint="#CC0000" android:textColor="#FFFFFF"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView android:text="@string/fn_preview_note"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textSize="10sp" android:letterSpacing="0.08"
                android:textColor="#FFB300" android:layout_marginBottom="12dp"/>

            <!-- PAIRING -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="#0D0D10"
                android:padding="16dp" android:layout_marginBottom="12dp">

                <TextView android:text="@string/fn_your_code"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:letterSpacing="0.2" android:textColor="#666666"/>
                <TextView android:id="@+id/tv_pair_code"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="TRAP-8921" android:textSize="30sp" android:textStyle="bold"
                    android:textColor="#FFFFFF" android:letterSpacing="0.1"
                    android:gravity="center" android:padding="14dp"
                    android:background="#14141A" android:layout_marginTop="8dp"/>
                <TextView android:text="@string/fn_code_hint"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textColor="#555555"
                    android:gravity="center" android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"/>

                <TextView android:text="@string/fn_enter_code"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:letterSpacing="0.2" android:textColor="#666666"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <EditText android:id="@+id/et_family_code"
                        android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="@string/fn_code_input_hint"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:maxLength="12" android:maxLines="1"
                        android:textColor="#FFFFFF" android:textColorHint="#444444"
                        android:textSize="15sp" android:paddingStart="12dp"
                        android:paddingEnd="12dp" android:background="#14141A"/>
                    <Button android:id="@+id/btn_family_connect"
                        android:layout_width="wrap_content" android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/fn_connect" android:textSize="12sp"
                        android:backgroundTint="#CC0000" android:textColor="#FFFFFF"/>
                </LinearLayout>

                <TextView android:id="@+id/tv_family_status"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/fn_status_disconnected"
                    android:textSize="12sp" android:textStyle="bold"
                    android:textColor="#FF4444" android:letterSpacing="0.05"
                    android:background="#1A0A0A" android:paddingStart="12dp"
                    android:paddingEnd="12dp" android:paddingTop="6dp"
                    android:paddingBottom="6dp" android:layout_marginTop="14dp"/>
            </LinearLayout>

            <!-- LIVE MAP PREVIEW -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="220dp"
                android:layout_marginBottom="12dp">
                <com.thievestrap.MockMapView
                    android:layout_width="match_parent" android:layout_height="match_parent"/>
                <TextView android:text="@string/fn_map_title"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="top|start" android:layout_margin="10dp"
                    android:textSize="10sp" android:letterSpacing="0.15"
                    android:textColor="#9FB3C8" android:background="#AA0B1018"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"/>
                <TextView android:text="@string/fn_map_caption"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal" android:layout_margin="10dp"
                    android:textSize="11sp" android:textColor="#FFFFFF"
                    android:background="#AA000000"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="4dp" android:paddingBottom="4dp"/>
            </FrameLayout>

            <!-- CONTROLS -->
            <Button android:id="@+id/btn_family_start"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="@string/fn_start" android:textSize="13sp" android:textStyle="bold"
                android:backgroundTint="#1B8A3A" android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btn_family_stop"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="@string/fn_stop" android:textSize="13sp" android:textStyle="bold"
                android:backgroundTint="#333344" android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btn_family_alarm"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="@string/fn_alarm" android:textSize="13sp" android:textStyle="bold"
                android:backgroundTint="#CC5500" android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp"/>

            <!-- HISTORY -->
            <LinearLayout android:id="@+id/card_family_history"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="#0D0D10"
                android:padding="16dp" android:layout_marginBottom="16dp"
                android:clickable="true" android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView android:text="@string/fn_history"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                <TextView android:text="@string/fn_history_sub"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textColor="#555555"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
